# Salin ke .env.local untuk pengembangan lokal (vercel dev). JANGAN di-commit.
# Di Vercel, isi lewat Settings → Environment Variables.

# Dari Upstash Redis → tab REST API
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=isi_token_anda

# Password untuk masuk ke /admin (pakai yang panjang & unik)
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Kunci penanda tangan sesi login, minimal 16 karakter acak.
# Buat dengan:  openssl rand -base64 32
SESSION_SECRET=ganti-dengan-string-acak-panjang
